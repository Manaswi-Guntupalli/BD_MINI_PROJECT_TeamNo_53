# Replace with the actual ZeroTier IPs from your four VMs.
NODE1_HOST=10.147.20.1
NODE2_HOST=10.147.20.2
NODE3_HOST=10.147.20.3
NODE4_HOST=10.147.20.4
SPARK_MASTER=spark://10.147.20.3:7077
HDFS_URI=hdfs://10.147.20.2:9000
ICEBERG_CATALOG=lake
ICEBERG_NAMESPACE=search
ICEBERG_WAREHOUSE=hdfs://10.147.20.2:9000/search/warehouse
SERVING_ROOT=/srv/distributed-search
# All nodes need consistent Hadoop/Spark environment.
# Default versions below match the team VM installation: Spark 3.3.4 / Scala 2.12.
ICEBERG_RUNTIME=org.apache.iceberg:iceberg-spark-runtime-3.3_2.12:1.6.1
SPARK_KAFKA_PACKAGE=org.apache.spark:spark-sql-kafka-0-10_2.12:3.3.4
KAFKA_BOOTSTRAP=10.147.20.1:9092

# Optional SSH override ON NODE4 if the VM3 Linux username differs:
# NODE3_SSH_TARGET=VM3_LINUX_USERNAME@10.147.20.3
# Required on ALL Spark driver/worker nodes (Spark 3.3.4 not Python 3.12):
PYSPARK_PYTHON=/usr/bin/python3.10
PYSPARK_DRIVER_PYTHON=/usr/bin/python3.10
